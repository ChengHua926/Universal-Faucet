# Private key of the account that deploys the contract to Sapphire testnet.
# Export it from your Oasis wallet (see instructions), then copy this file to
# `.env` and paste the key below. NEVER commit the real .env. Testnet only.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# bytes21 form of your ROFL app id (bech32-decoded from rofl1...)
ROFL_APP_ID=0xYOUR_ROFL_APP_ID_BYTES21
