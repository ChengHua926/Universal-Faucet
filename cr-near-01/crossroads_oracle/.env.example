# Source chain: INDEPENDENT RPCs (comma-separated). Independence of operators is
# what makes agreement meaningful — don't list 3 proxies to one backend. This is
# the default served when a request omits ?config=; multi-chain requests read
# their RPC set from the named oracle contract instead.
SOURCE_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org,https://1rpc.io/sepolia
# How many sources must recompute the same block hash before we sign.
SOURCE_RPC_QUORUM=2
# Depth below the quorum tip before a block is eligible (reorg safety).
SOURCE_CONFIRMATIONS=12
# Expected source chain id; RPCs reporting a different chainId are rejected.
SOURCE_CHAIN_ID=11155111
# SOURCE_REQUIRE_FINALIZED=1   # also require the source quorum to report finality

# Target chain: Sapphire, where the HeaderReportOracle contract(s) live.
TARGET_RPC_URL=https://testnet.sapphire.oasis.io
SAPPHIRE_CHAIN_ID=23295
# Primary oracle contract, served when a request omits ?config=.
ORACLE_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# The TEE (ROFL) is the only signer: the key is derived in-enclave from KMS and
# never persisted, and registration/submission go through the appd socket. There
# is no file-backed / non-TEE signer.
ORACLE_MODE=rofl
# ROFL_KMS_KEY_ID=crossroads-header-signer-v1
# ALLOW_SIGNER_ROTATION=1      # permit rotating an already-registered signer

# --- Multi-chain (one container serves every EVM chain) -----------------------
# A request carrying ?config=0xORACLE is served from that contract's own source
# config. These bound the (attacker-influenceable) surface; defaults are fine.
MULTI_CHAIN_MAX_SOURCE_RPC_URLS=16
MULTI_CHAIN_CONFIG_TTL_SECONDS=300
MULTI_CHAIN_PER_CONFIG_RATE_LIMIT_PER_MINUTE=0
