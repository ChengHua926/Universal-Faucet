# Source chain: 3 INDEPENDENT Sepolia RPCs (comma-separated). Independence of
# operators is what makes agreement meaningful — don't list 3 proxies to one backend.
SOURCE_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org,https://1rpc.io/sepolia
# How many must report the same hash before we sign (majority of sources).
QUORUM=2
CONFIRMATIONS=6
# Max blocks to cover per cycle (gap-free window fill for the bridge).
BATCH_SIZE=16

# Target chain: Sapphire testnet, where the BlockHashOracle contract lives.
TARGET_RPC_URL=https://testnet.sapphire.oasis.io
ORACLE_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# Step 1 (local mode) ONLY: key used to sign storeBlockHash from your laptop.
# In Step 2 (ROFL mode) the TEE signs via the appd socket and this is unused.
# Testnet only — never commit the real .env.
LOCAL_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
