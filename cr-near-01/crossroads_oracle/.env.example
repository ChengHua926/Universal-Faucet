# ROFL app mode is required because register/rotate must be submitted through
# /rofl/v1/tx/sign-submit for Sapphire roflEnsureAuthorizedOrigin to pass.
ORACLE_MODE=rofl

# Sapphire target for CrossroadsHeaderOracle.
TARGET_RPC_URL=https://testnet.sapphire.oasis.io
SAPPHIRE_CHAIN_ID=23295
ORACLE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Source-chain request-driven header API.
SOURCE_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org,https://1rpc.io/sepolia
SOURCE_RPC_QUORUM=2
SOURCE_CONFIRMATIONS=12
SOURCE_CHAIN_ID=11155111
SOURCE_REQUIRE_FINALIZED=0

# Signed report serving, cache, and best-effort global rate limit.
HEADER_REPORT_TTL_SECONDS=1800
HEADER_REPORT_CACHE_SIZE=512
HEADER_REPORT_CACHE_REFRESH_SECONDS=120
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_RATE_LIMIT_PER_MINUTE=60

# ROFL KMS secp256k1 signer. Changing this key id is an explicit signer rotation.
ROFL_KMS_KEY_ID=crossroads-header-signer-v1

# Keep 0 by default. Set to 1 only when intentionally rotating the header signer.
ALLOW_SIGNER_ROTATION=0

# Legacy fallback only. Production should keep this disabled.
ALLOW_LEGACY_FILE_SIGNER=0
# ORACLE_SIGNING_KEY_PATH=/storage/crossroads-header-signer.json

# Contract deployment. ROFL_APP_ID may be rofl1... or 0x + 42 hex chars.
ROFL_APP_ID=rofl1...
PRIVATE_KEY=
